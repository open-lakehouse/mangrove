{
  "name": "@open-lakehouse/editor",
  "version": "0.0.0",
  "type": "module",
  "description": "Embeddable Monaco editor for React: SQL with live diagnostics and catalog-aware completion, markdown and plain text, plus a multi-tab file-editing shell (./session) with autosave and a host-wired run command.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/open-lakehouse/mangrove.git",
    "directory": "node/editor"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "files": [
    "dist",
    "src",
    "!src/**/*.test.ts",
    "!src/**/*.test.tsx",
    "!src/**/*.stories.tsx",
    "README.md",
    "DESIGN.md",
    "CHANGELOG.md"
  ],
  "sideEffects": false,
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./session": {
      "source": "./src/session.ts",
      "types": "./dist/session.d.ts",
      "import": "./dist/session.js"
    },
    "./fixtures": {
      "source": "./src/fixtures.ts",
      "types": "./dist/fixtures.d.ts",
      "import": "./dist/fixtures.js"
    },
    "./package.json": "./package.json"
  },
  "dependencies": {
    "@monaco-editor/react": "^4.7.0",
    "dompurify": "^3.4.16",
    "dt-sql-parser": "^4.5.1",
    "lucide-react": "^1.55.0",
    "marked": "^18.1.0",
    "monaco-editor": "0.54.0",
    "monaco-sql-languages": "1.2.1"
  },
  "peerDependencies": {
    "@open-lakehouse/ui-kit": "0.0.1",
    "react": "^19.2.6",
    "react-dom": "^19.2.6"
  },
  "devDependencies": {
    "@open-lakehouse/ui-kit": "https://github.com/open-lakehouse/trestle/releases/download/ui-kit-v0.0.1/open-lakehouse-ui-kit-0.0.1.tgz",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "^6.0.3"
  },
  "scripts": {
    "build": "bun run ../../scripts/build-package.ts",
    "prepack": "bun run build",
    "typecheck": "tsc --noEmit"
  }
}
