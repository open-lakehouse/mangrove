{
  "name": "@open-lakehouse/uc-a2ui",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Unity Catalog A2UI catalog (agent-rendered grant form) and the MCP App that hosts it for `uc mcp serve`.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/open-lakehouse/mangrove.git",
    "directory": "node/uc-a2ui"
  },
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    ".": {
      "source": "./src/index.ts"
    },
    "./package.json": "./package.json"
  },
  "dependencies": {
    "@a2ui/react": "0.15.0",
    "@a2ui/web_core": "0.15.0",
    "@modelcontextprotocol/ext-apps": "2.0.4",
    "@open-lakehouse/host": "https://github.com/open-lakehouse/trestle/releases/download/host-v0.0.3/open-lakehouse-host-0.0.3.tgz",
    "@open-lakehouse/ui-kit": "https://github.com/open-lakehouse/trestle/releases/download/ui-kit-v0.0.1/open-lakehouse-ui-kit-0.0.1.tgz",
    "@open-lakehouse/unity-catalog-client": "workspace:*",
    "@open-lakehouse/unity-catalog-ui": "workspace:*",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@a2ui/agent": "0.1.0",
    "@happy-dom/global-registrator": "^21.0.4",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.8",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vite": "^8.3.4",
    "vite-plugin-singlefile": "2.3.4"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit && vite build",
    "sync:cli": "bun scripts/sync-cli.ts",
    "check:cli": "bun scripts/sync-cli.ts --check"
  }
}
