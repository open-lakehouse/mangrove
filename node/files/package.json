{
  "name": "@open-lakehouse/files",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Volume-files seam (FilesRunner) and React hooks for listing, reading and writing volume files.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/open-lakehouse/mangrove.git",
    "directory": "node/files"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "files": [
    "dist",
    "src",
    "!src/**/*.test.ts",
    "!src/**/*.test.tsx",
    "!src/**/*.stories.tsx",
    "README.md",
    "DESIGN.md",
    "CHANGELOG.md"
  ],
  "sideEffects": false,
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./testing": {
      "source": "./src/testing/stubRunner.ts",
      "types": "./dist/testing/stubRunner.d.ts",
      "import": "./dist/testing/stubRunner.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "bun run ../../scripts/build-package.ts",
    "prepack": "bun run build",
    "test": "bun test",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "react": "^19.2.6",
    "react-dom": "^19.2.6"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "^6.0.3"
  }
}
