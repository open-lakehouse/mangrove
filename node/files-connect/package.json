{
  "name": "@open-lakehouse/files-connect",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "ConnectRPC bindings for the portal.files.v1 FilesService.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/open-lakehouse/mangrove.git",
    "directory": "node/files-connect"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "files": [
    "dist",
    "src",
    "!src/**/*.test.ts",
    "!src/**/*.test.tsx",
    "!src/**/*.stories.tsx",
    "README.md",
    "DESIGN.md",
    "CHANGELOG.md"
  ],
  "sideEffects": false,
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "bun run ../../scripts/build-package.ts",
    "gen": "just generate-files-es",
    "prepack": "bun run build",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@bufbuild/protobuf": "^2.16.0",
    "@connectrpc/connect": "^2.2.0"
  },
  "devDependencies": {
    "typescript": "^6.0.3"
  }
}
