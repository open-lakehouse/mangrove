{
  "name": "@open-lakehouse/unity-catalog-ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Unity Catalog browser components (catalog explorer, entity details, dialogs) for React.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/open-lakehouse/mangrove.git",
    "directory": "node/unity-catalog-ui"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "files": [
    "dist",
    "src",
    "!src/**/*.test.ts",
    "!src/**/*.test.tsx",
    "!src/**/*.stories.tsx",
    "README.md",
    "DESIGN.md",
    "CHANGELOG.md"
  ],
  "sideEffects": false,
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "dependencies": {
    "@open-lakehouse/data-grid": "^0.1.0",
    "@open-lakehouse/editor": "^0.1.0",
    "@open-lakehouse/files": "^0.1.0",
    "@open-lakehouse/log-query": "^0.1.0",
    "@open-lakehouse/query": "^0.1.0",
    "@open-lakehouse/ui-kit": "^0.1.0",
    "@open-lakehouse/unity-catalog-client": "workspace:*",
    "@rjsf/core": "^5.24.13",
    "@rjsf/utils": "^5.24.13",
    "@rjsf/validator-ajv8": "^5.24.13",
    "ajv": "^8.20.0",
    "lucide-react": "^1.55.0",
    "sonner": "^2.0.8"
  },
  "peerDependencies": {
    "@tanstack/react-query": "^5.100.14",
    "@tanstack/react-router": "^1.170.10",
    "react": "^19.2.6",
    "react-dom": "^19.2.6"
  },
  "devDependencies": {
    "@tanstack/react-query": "^5.104.1",
    "@tanstack/react-router": "^1.170.42",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "^6.0.3",
    "vite": "^8.3.4"
  },
  "scripts": {
    "build": "bun run ../../scripts/build-package.ts",
    "gen:form-schemas": "node scripts/gen-form-schemas.mjs",
    "prepack": "bun run build",
    "typecheck": "tsc --noEmit"
  }
}
