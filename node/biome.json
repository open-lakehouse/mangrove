{
  "root": false,
  "$schema": "https://biomejs.dev/schemas/2.5.15/schema.json",
  "extends": "//",
  "files": {
    "includes": [
      "**",
      "!**/dist/**/*",
      "!**/storybook-static/**/*",
      "!**/node_modules/**/*",
      "!**/unity-catalog-client/src/uc-api.d.ts",
      "!**/unity-catalog-ui/src/forms/schemas/**/*",
      "!**/query-runner/src/gen/**/*",
      "!**/files-connect/src/gen/**/*"
    ]
  },
  "linter": {
    "rules": {
      "preset": "recommended",
      "suspicious": {
        "noExplicitAny": "warn"
      },
      "style": {
        "noDefaultExport": "warn"
      }
    }
  },
  "overrides": [
    {
      "includes": [
        "**/*.stories.tsx",
        "**/vite.config.ts",
        "**/.storybook/**",
        "**/*.d.ts"
      ],
      "linter": {
        "rules": {
          "style": {
            "noDefaultExport": "off"
          }
        }
      }
    },
    {
      "includes": ["arrow-grid/src/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["@open-lakehouse/unity-catalog-ui"],
                    "message": "arrow-grid is a leaf: it must not import Unity Catalog. The Unity Catalog package may build on arrow-grid, never the reverse."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["query-runner/src/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["@open-lakehouse/unity-catalog-ui"],
                    "message": "query-runner is a leaf: it must not import Unity Catalog. The Unity Catalog package may build on query-runner, never the reverse."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["query-wasm/src/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["@open-lakehouse/unity-catalog-ui"],
                    "message": "query-wasm implements the @open-lakehouse/query-runner runner contract and must not import Unity Catalog UI: the app composes them, never the packages themselves."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["files-wasm/src/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["@open-lakehouse/unity-catalog-ui"],
                    "message": "files-wasm implements the @open-lakehouse/volume-files runner contract and must not import Unity Catalog UI: the app composes them, never the packages themselves."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["files-connect/src/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["@open-lakehouse/unity-catalog-ui"],
                    "message": "files-connect is the write-capable ConnectRPC surface for the @open-lakehouse/volume-files seam and must not import Unity Catalog UI: the app composes them, never the packages themselves."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["delta-log/src/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["@open-lakehouse/unity-catalog-ui"],
                    "message": "delta-log is a leaf: it must not import Unity Catalog. The Unity Catalog package may build on delta-log (renders a Delta-log tab), never the reverse."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["volume-files/src/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["@open-lakehouse/unity-catalog-ui"],
                    "message": "volume-files is a leaf: it must not import Unity Catalog. The Unity Catalog package may build on volume-files (renders a volume Files tab), never the reverse."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["editor/src/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "@open-lakehouse/unity-catalog-ui",
                      "@open-lakehouse/query-runner",
                      "@open-lakehouse/arrow-grid"
                    ],
                    "message": "editor is a leaf: it must not import Unity Catalog, query-runner, or arrow-grid. The Unity Catalog package builds on the editor and pushes catalog context in via registerCatalogProvider; run/results are wired by the consumer via an injected onRun callback. Never the reverse."
                  }
                ]
              }
            }
          }
        }
      }
    }
  ]
}
