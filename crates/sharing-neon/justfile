# The Open Sharing server as a Neon Function (crates/sharing-neon).
# Recipes run from the repository root: `just sharing-neon <recipe>`.

set working-directory := '../..'

FN := "crates/sharing-neon/function"
# Neon Functions run Node 24 on linux-arm64 glibc; 2.28 is the glibc floor of
# the official Node 24 binaries.
TARGET := "aarch64-unknown-linux-gnu.2.28"
ZIP := "crates/sharing-neon/sharing-neon.zip"
# Neon's deploy limits: 10 MiB compressed, 64 MiB uncompressed.
MAX_ZIP := "10485760"
MAX_UNZIPPED := "67108864"

_default:
    @just --list sharing-neon

# Needs `zig` + cargo-zigbuild >= 0.23.
#
# build the deployable bundle + zip; fails over Neon's size limits
build:
    #!/usr/bin/env bash
    set -euo pipefail
    cargo zigbuild -p olai-sharing-neon --profile release-neon --target {{ TARGET }}
    just sharing-neon _dist target/aarch64-unknown-linux-gnu/release-neon/libolai_uc_sharing_neon.so
    rm -f {{ ZIP }}
    (cd {{ FN }}/dist && zip -9 -q -r "$OLDPWD/{{ ZIP }}" .)
    zipped=$(wc -c < {{ ZIP }} | tr -d ' ')
    unzipped=$(unzip -l {{ ZIP }} | tail -1 | awk '{print $1}')
    echo "→ {{ ZIP }}: $zipped bytes zipped (limit {{ MAX_ZIP }}), $unzipped unzipped (limit {{ MAX_UNZIPPED }})"
    if [ "$zipped" -ge {{ MAX_ZIP }} ] || [ "$unzipped" -ge {{ MAX_UNZIPPED }} ]; then
        echo "error: bundle exceeds Neon's deploy limits" >&2; exit 1
    fi

# build the bundle with a host-native (debug) addon, for local testing
build-host:
    #!/usr/bin/env bash
    set -euo pipefail
    cargo build -p olai-sharing-neon
    lib=target/debug/libolai_uc_sharing_neon.dylib
    [ -f "$lib" ] || lib=target/debug/libolai_uc_sharing_neon.so
    just sharing-neon _dist "$lib"

# Stage `dist/`: the addon as native/sharing.node, plus index.mjs emitted by
# Node's built-in TypeScript type stripping (Node >= 22.13; no npm deps).
_dist lib:
    rm -rf {{ FN }}/dist && mkdir -p {{ FN }}/dist/native
    cp {{ lib }} {{ FN }}/dist/native/sharing.node
    node --no-warnings --input-type=module -e "import { readFileSync, writeFileSync } from 'node:fs'; import { stripTypeScriptTypes } from 'node:module'; writeFileSync('{{ FN }}/dist/index.mjs', stripTypeScriptTypes(readFileSync('{{ FN }}/index.ts', 'utf8')));"

# smoke-test the function handler on the host (in-memory store)
test: build-host
    node --test {{ FN }}/smoke.test.mjs

# smoke-test the deployable linux-arm64 bundle in a Node 24 container
test-arm64: build
    docker run --rm --platform linux/arm64 -v "$PWD/{{ FN }}:/fn:ro" -w /fn \
        node:24-bookworm-slim node --test smoke.test.mjs

# Migrations are never applied by the function itself; run once per schema
# change, over the branch's *direct* connection string (the migrator holds a
# session advisory lock, which the pooled DATABASE_URL can't keep).
#
# apply migrations to a Neon branch (needs DATABASE_URL_UNPOOLED)
migrate:
    DATABASE_URL="${DATABASE_URL_UNPOOLED:?set DATABASE_URL_UNPOOLED to the branch direct (unpooled) connection string}" \
    cargo run -p olai-sharing-server --features bin -- migrate

# deploy the built bundle as a Neon Function (needs the `neon` CLI, logged in)
deploy slug="open-sharing": build
    neon functions deploy {{ slug }} --src {{ FN }}/dist --no-bundle --wait
