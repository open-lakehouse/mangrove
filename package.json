{
  "name": "unitycatalog",
  "packageManager": "bun@1.3.14",
  "workspaces": [
    "node/client",
    "node/arrow-grid",
    "node/query-runner",
    "node/query-wasm",
    "node/delta-log",
    "node/volume-files",
    "node/files-connect",
    "node/files-wasm",
    "node/editor",
    "node/unity-catalog-client",
    "node/unity-catalog-ui",
    "node/app"
  ],
  "scripts": {
    "openapi": "prettier --write openapi/openapi.yaml",
    "lint-fix": "biome check --write && biome format --write .",
    "postinstall": "[ ! -f scripts/strip-bun-lock-proxy.ts ] || bun run scripts/strip-bun-lock-proxy.ts",
    "setup-hooks": "git config core.hooksPath .githooks",
    "strip-lock-proxy": "bun run scripts/strip-bun-lock-proxy.ts",
    "strip-lock-proxy:check": "bun run scripts/strip-bun-lock-proxy.ts --check",
    "cargo-lock:check": "bash dev/scripts/crates-proxy.sh check-lock",
    "test:coverage": "bun test --coverage --coverage-reporter=lcov",
    "typecheck": "bun run --filter \"./node/*\" typecheck",
    "lint:node": "biome check node",
    "test:ui": "bun test --conditions source node --path-ignore-patterns \"node/client/**\"",
    "pack:check": "bun run scripts/pack-check.ts",
    "build:packages": "bun run --filter @open-lakehouse/unity-catalog-client --filter @open-lakehouse/arrow-grid --filter @open-lakehouse/editor --filter @open-lakehouse/query-runner --filter @open-lakehouse/volume-files --filter @open-lakehouse/files-connect --filter @open-lakehouse/delta-log --filter @open-lakehouse/unity-catalog-ui build",
    "pack:check:all": "bun run scripts/pack-check.ts node/unity-catalog-client node/arrow-grid node/editor node/query-runner node/volume-files node/files-connect node/delta-log node/unity-catalog-ui",
    "build:storybook": "bun run --filter @open-lakehouse/uc-app build-storybook"
  },
  "dependencies": {
    "eslint": "^10.12.0",
    "prettier": "^3.9.10",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@biomejs/biome": "2.5.15",
    "publint": "^0.3.25"
  }
}
