{
  "name": "unitycatalog",
  "packageManager": "bun@1.3.14",
  "workspaces": [
    "node/client",
    "node/ui-kit",
    "node/data-grid",
    "node/query",
    "node/query-wasm",
    "node/log-query",
    "node/files",
    "node/files-connect",
    "node/files-wasm",
    "node/editor",
    "node/unity-catalog-client",
    "node/unity-catalog-ui",
    "node/app"
  ],
  "scripts": {
    "openapi": "prettier --write openapi/openapi.yaml",
    "lint-fix": "biome check --write && biome format --write .",
    "setup-hooks": "git config core.hooksPath .githooks",
    "strip-lock-proxy": "bun run scripts/strip-bun-lock-proxy.ts",
    "strip-lock-proxy:check": "bun run scripts/strip-bun-lock-proxy.ts --check",
    "cargo-lock-trestle:check": "bash scripts/check-cargo-lock-trestle.sh",
    "test:coverage": "bun test --coverage --coverage-reporter=lcov",
    "changeset": "changeset",
    "changeset:version": "changeset version",
    "changeset:autogen": "bun run scripts/autogen-changeset.ts",
    "typecheck": "bun run --filter \"./node/*\" typecheck",
    "lint:node": "biome check node",
    "test:ui": "bun test --conditions source node --path-ignore-patterns \"node/client/**\""
  },
  "dependencies": {
    "eslint": "^10.12.0",
    "prettier": "^3.9.10",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@biomejs/biome": "2.5.15",
    "@changesets/changelog-github": "^1.0.1",
    "@changesets/cli": "^3.0.3",
    "publint": "^0.3.25"
  }
}
